# Postgres connection string (Neon or any Postgres works)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (non-pooled) connection, used for running migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Tax rate applied to invoice subtotal, in percent
TAX_RATE_PERCENT="11"

PORT="4000"
# Origin allowed to call the API with credentials (the frontend URL)
FRONTEND_ORIGIN="http://localhost:3000"
